# The published tutorial dataset is deliberately limited to the lightweight,
# directly usable inputs listed below. Other locally generated or source
# rasters and vector sidecars stay outside the repository.
/tutorial/*
!/tutorial/avalanches.geojson
!/tutorial/satellite.png
!/tutorial/satellite.pgw
!/tutorial/topo_cut_dam_1m.tif
